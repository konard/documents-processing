# Copy to .env and fill in. The real .env is git-ignored.

# Token from @BotFather, used by src/evisa-bot-run.mjs
EVISA_BOT_TOKEN=

# Optional. With 1, each chat's browser is a visible window on this machine.
EVISA_BOT_HEADED=
# Optional. A port from which each chat's browser listens for a debugger
# (chrome://inspect, or Playwright's connectOverCDP); the log names the port.
EVISA_BOT_CDP_PORT=
