# Copy to .env and fill in. The real .env is git-ignored.

# Token from @BotFather, used by src/evisa-bot-run.mjs
EVISA_BOT_TOKEN=

# Optional. With 1, each chat's browser is a visible window on this machine.
EVISA_BOT_HEADED=
# Optional. A port from which each chat's browser listens for a debugger
# (chrome://inspect, or Playwright's connectOverCDP); the log names the port.
EVISA_BOT_CDP_PORT=
# Optional. Defaults to ~/Downloads. Set an absolute path to use another
# persistent folder, or "temporary" to retain Playwright's temporary behavior.
EVISA_BOT_DOWNLOADS_DIR=

# Optional private defaults used when a traveller has not supplied a stay.
# Keep real addresses in `.env`; never put them in source, tests, or docs.
EVISA_BOT_DEFAULT_ADDRESS=
EVISA_BOT_DEFAULT_PROVINCE=
EVISA_BOT_DEFAULT_WARD=
