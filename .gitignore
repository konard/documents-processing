# documents-processing: real (private) document data must never be committed.
# It lives in the data/ folder of your working tree; only the *.example.json
# templates there are tracked. Copy them and fill in locally.
# What the bot remembers between runs: chat ids, the language each chose and
# the applications registered for them. All of it is personal.
data/chats.lino
data/chats.lino.writing
data/match-checks-data.json
data/ocr-overrides.json
# Gmail OAuth secrets and issued token — never commit.
data/gmail-credentials.json
data/gmail-token.json
.env
# Browser session for the browser-commander Gmail path (cookies, profile).
data/gmail-browser-profile/
data/gmail-state.json
data/chrome-cookies-*.json
# Cached Chrome "Safe Storage" key (a local secret) — never commit.
data/.chrome-safe-storage-key.json
# Dedicated real-Chrome CDP profile (holds a logged-in session) — never commit.
data/chrome-cdp-*profile/
# Other spawned Console/Gmail browser profiles (logged-in sessions) — never commit.
data/gcloud-console-*profile/
data/chrome-cdp-console-*/
# Debug screenshots from the Console/consent automation (--debug-shots). They
# show the signed-in account's email/PII, so they must NEVER be committed.
data/consent-debug/
data/consent-auth-debug/
# Console-automation run logs (may echo account details) — never commit.
data/gcloud-run.log
data/consent-auth.log
data/fetch-run.log
data/gmail-status.log
# Resume cache of fetched emails (raw message bodies) — never commit.
data/flight-cancellations-cache/
# Fetched emails and the exhibits built from them hold personal travel data.
flight-cancellations-originals/
flight-cancellation-final/
# The exhibit list names a real booking; only the example template is tracked.
data/frro-exhibits.json
# Cached / downloaded fonts (never shipped in this repo).
data/fonts/
# Debug/render artifacts and any real scanned documents kept alongside the code.
tests/out/

# e-visa application output: filled-form screenshots, prepared passport and
# portrait images, and resolved applicant records all contain personal data.
evisa-output/
evisa-*.png
evisa-*.jpg
evisa-*.jpeg
*.evisa.json
*.evisa.lino
# Anchored to the root so they do not swallow the committed test fixtures.
/applicant.json
/applicant.lino
.playwright-mcp/

# Test fixtures are placeholder data and are meant to be committed.
!tests/fixtures/**
test-results/
