# EXAMPLE. Copy to .env in your working (base) directory and fill in your own
# Google Cloud OAuth client credentials. These placeholders grant no access.
# Used by src/gmail-lib.mjs as an alternative to data/gmail-credentials.json.
GMAIL_CLIENT_ID=000000000000-EXAMPLECLIENTIDxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=EXAMPLE-CLIENT-SECRET-xxxxxxxxxxxx
# Optional: override the OAuth redirect URI (default is a localhost listener).
# GMAIL_REDIRECT_URI=http://localhost
